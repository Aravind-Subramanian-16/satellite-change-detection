# Copy to .env and fill in. Never commit .env.
# Copernicus Data Space Ecosystem OAuth client (Sentinel Hub APIs).
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Local persistence.
ANALYSIS_DB_PATH=analysis_history.sqlite3

# Optional CNN weights (not committed). A valid file is 33,268,410 bytes.
MODEL_ONNX_PATH=model.onnx
MODEL_PT_PATH=best_model.pt

# Optional learned pixel classifier (Phase D). Not committed.
LEARNED_MODEL_PATH=models/pixel_classifier.joblib
ENABLE_LEARNED_MODEL=0

# OpenStreetMap road context cache.
OSM_CACHE_DIR=cache/osm

# Live workflow limits.
MAX_AOI_KM=10
DEFAULT_WINDOW_DAYS=30
CLOUD_WARN_PERCENT=30
MAX_ANALYSIS_PX=1024

# Production safety.
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
