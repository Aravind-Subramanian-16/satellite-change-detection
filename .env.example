# Optional Copernicus Data Space credentials for live Sentinel-2 features.
# Keep real credentials in your local .env or platform secret manager only.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional local model paths.
MODEL_ONNX_PATH=model.onnx
MODEL_PT_PATH=best_model.pt

# Local analysis history database.
ANALYSIS_DB_PATH=analysis_history.sqlite3
