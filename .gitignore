# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Virtual Environment ──────────────────────────────────
venv/
.venv/
env/

# ── Credentials ──────────────────────────────────────────
.env
analysis_history.sqlite3

# ── Large Model Files (GitHub 100MB limit) ───────────────
*.pt
*.onnx
*.pth
*.joblib
artifacts/

# ── Dataset (too large for GitHub) ───────────────────────
dataset/
dataset.zip
training_results.zip

# ── macOS ────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE / Editor ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs & temp files ────────────────────────────────────
server_log.txt
*.log

# OSCD benchmark results under benchmarks/results are intentionally trackable.
# ── Test outputs & scratch ───────────────────────────────
response.json
test_result.json

# ── Archives & media (keep out of history) ──────────────
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.mp4
*.mov
*.avi
*.mkv

# ── LaTeX build artefacts ────────────────────────────────
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.toc
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.fls
docs/paper/*.fdb_latexmk
docs/paper/*.synctex.gz
docs/paper/*.pdf

# ── Large result artefacts ───────────────────────────────
/results/
*.csv.gz
*.h5
*.hdf5
*.pkl

# ── Colab / notebook checkpoints ─────────────────────────
.ipynb_checkpoints/
